# Infinix X6840 (Smart 20) - vendor sepolicy
# SPDX-License-Identifier: Apache-2.0
#
# Catatan Treble:
#  - properti milik /vendor wajib memakai makro vendor_internal_prop
#    (bukan `type ..., property_type` polos),
#  - service /vendor hanya boleh di-find oleh app bila bertipe
#    app_api_service (otherwise neverallow),
#  - coredomain (mis. system_server) tidak boleh menulis properti vendor,
#  - aturan `vendor_init vendor_file` sudah ada di AOSP, jadi tidak diulang.

# --- Properti khas vendor MTK ---
vendor_internal_prop(vendor_mtk_prop)
allow vendor_init vendor_mtk_prop:property_service set;
allow vendor_init vendor_mtk_prop:file { read open getattr map };

# --- Service Transsion (vendor) reachable dari app ---
type transsion_service, app_api_service, service_manager_type;
allow platform_app transsion_service:service_manager find;
allow system_app transsion_service:service_manager find;
allow untrusted_app_all transsion_service:service_manager find;
