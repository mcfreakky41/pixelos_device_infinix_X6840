// =============================================================================
// 15 APK stok /vendor (5 di vendor/app, 10 di vendor/overlay)
//
// Kenapa tidak lewat PRODUCT_COPY_FILES?
//   build/make/core/Makefile:101-104 (fork PixelOS, identik dengan AOSP)
//   menghentikan build untuk SETIAP tujuan PRODUCT_COPY_FILES yang berakhiran
//   ".apk", tanpa escape hatch BUILD_BROKEN_*:
//     $(if $(filter %.apk, $(2)),$(error Prebuilt apk found ...))
//   Sudah diverifikasi pada sumber PixelOS-AOSP/build branch sixteen.
//
// Kenapa prebuilt_any, bukan android_app_import?
//   1. android_app_import selalu memasang ke <partisi>/app/<nama-modul>/...
//      sehingga (a) /vendor/overlay/* tidak mungkin dicapai, dan (b) nama
//      modul akan bentrok dengan modul AOSP bernama sama (FrameworkResOverlay,
//      SystemUIResOverlay, dst).
//   2. android_app_import menjalankan validasi presigned
//      (check_prebuilt_presigned_apk.py) pada APK stok lama.
//   3. prebuilt_any + sub_dir memasang file BYTE-IDENTIK ke path yang persis
//      sama dengan dump stok, tanpa signing/dexopt/validasi.
//
// Catatan: modul ini hanya mengisi vendor.img. Kita TIDAK mem-flash
// vendor.img (vendor/odm stok tetap dipakai), jadi isinya harus identik.
// =============================================================================

prebuilt_any {
    name: "x6840_vendor_NetworkStackGoogleGoResOverlay",
    src: "proprietary/vendor/app/NetworkStackGoogleGoResOverlay/NetworkStackGoogleGoResOverlay.apk",
    filename: "NetworkStackGoogleGoResOverlay.apk",
    sub_dir: "app/NetworkStackGoogleGoResOverlay",
    soc_specific: true,
}

